# Copia a .env para la configuración no secreta.
# Crea ./secrets/credentials.env con las claves postgres_password, wildfly_admin_password,
# openproject_admin_password, openproject_secret_key_base y jwt_secret (secreto JWT compartido por los nodos WildFly). El fichero real queda fuera de Git.
POSTGRES_DB=template
POSTGRES_USER=administrador
POSTGRES_PORT=5432

WILDFLY_HTTP_PORT=8081
WILDFLY_HTTPS_PORT=8444
WILDFLY2_HTTPS_PORT=8445
WILDFLY_MANAGEMENT_PORT=9991
WILDFLY2_HTTP_PORT=8082
WILDFLY2_MANAGEMENT_PORT=9992
WILDFLY_ADMIN_USER=admin

APACHE_HTTP_PORT=8000
APACHE_HTTPS_PORT=4430

OPENPROJECT_PORT=8088
OPENPROJECT_HOST_NAME=localhost:8088
OPENPROJECT_DB=openproject
OPENPROJECT_HTTPS=false

MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025
