    <!-- Reset sequence to avoid conflicts with seed data -->
    <changeSet id="20250124-seed-local-interface-log-seq-reset" author="template" labels="v1.0.0" context="local">

        <preConditions onFail="MARK_RAN">
            <tableExists tableName="interface_log"/>
            <sequenceExists sequenceName="interface_log_seq"/>
        </preConditions>

        <comment>Ajusta la secuencia interface_log_seq para evitar conflictos con los datos seed</comment>

        <!-- PostgreSQL: setval calcula el siguiente valor a partir del MAX(id) actual -->
        <sql dbms="postgresql">SELECT setval('interface_log_seq', (SELECT COALESCE(MAX(id), 0) + 1 FROM interface_log), false)</sql>
        <!-- H2 (perfil local): setval no existe; se reinicia la secuencia al valor fijo
             siguiente a los ids seed (1-30) -->
        <sql dbms="h2">ALTER SEQUENCE interface_log_seq RESTART WITH 100</sql>

        <rollback/>

    </changeSet>

