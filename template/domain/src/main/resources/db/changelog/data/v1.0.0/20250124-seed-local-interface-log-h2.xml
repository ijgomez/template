    <!-- Seed data for local development: interface_log (H2 + PostgreSQL compatible) -->
    <!-- Context: local (only applied in local development environment) -->
    <!--
         El seed original 20250120-seed-local-interface-log usa <sql dbms="postgresql">
         con generate_series/ARRAY/setval, que H2 no soporta y por tanto ignora en local.
         Este changeSet reescribe los datos con <insert> agnósticos de motor para que
         también se apliquen en H2. La preCondition COUNT(*)=0 evita duplicar filas en
         PostgreSQL (donde el seed original ya habrá insertado sus registros).
    -->

