<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250106-create-user2report-table" author="template" labels="v1.0.0">

                <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="user2report"/>
            </not>
        </preConditions>

<comment>Creación de la tabla intermedia usuario-informe</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="user2report">
            <column name="user_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="report_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="user2report" columnNames="user_fk, report_fk"
                             constraintName="user2report_user_fk_report_fk_UK"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="user2report" baseColumnNames="user_fk"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="user2report_user_FK"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="user2report" baseColumnNames="report_fk"
                                 referencedTableName="report" referencedColumnNames="id"
                                 constraintName="user2report_report_FK"/>

        <rollback>
            <dropTable schemaName="${schemaName}" tableName="user2report"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
