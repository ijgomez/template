<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250111-create-cluster-task-table" author="template" labels="v1.0.0">

                <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="cluster_task"/>
            </not>
        </preConditions>

<comment>Creación de la tabla de tareas del clúster</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="cluster_task">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyTablespace="${tablespaceIndex}" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="nodes" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="min_nodes" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="cluster_task" columnNames="name"
                             constraintName="cluster_task_name_UK"/>

        <createSequence schemaName="${schemaName}" sequenceName="cluster_task_seq" startValue="1" incrementBy="50"/>

        <rollback>
            <dropSequence schemaName="${schemaName}" sequenceName="cluster_task_seq"/>
            <dropTable schemaName="${schemaName}" tableName="cluster_task"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
