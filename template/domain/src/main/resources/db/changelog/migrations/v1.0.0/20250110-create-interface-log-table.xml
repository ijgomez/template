<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250110-create-interface-log-table" author="template" labels="v1.0.0">

                <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="interface_log"/>
            </not>
        </preConditions>

<comment>Creación de la tabla de log de interfaces (append-only, inmutable)</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="interface_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyTablespace="${tablespaceIndex}" nullable="false"/>
            </column>
            <column name="timestamp" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="operation_type" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="interface_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_payload" type="TEXT"/>
            <column name="response_payload" type="TEXT"/>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createSequence schemaName="${schemaName}" sequenceName="interface_log_seq" startValue="1" incrementBy="50"/>

        <createIndex schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="interface_log" indexName="idx_interface_log_timestamp_interface_name">
            <column name="timestamp"/>
            <column name="interface_name"/>
        </createIndex>

        <createIndex schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="interface_log" indexName="idx_interface_log_status">
            <column name="status"/>
        </createIndex>

        <rollback>
            <dropIndex schemaName="${schemaName}" tableName="interface_log" indexName="idx_interface_log_status"/>
            <dropIndex schemaName="${schemaName}" tableName="interface_log" indexName="idx_interface_log_timestamp_interface_name"/>
            <dropSequence schemaName="${schemaName}" sequenceName="interface_log_seq"/>
            <dropTable schemaName="${schemaName}" tableName="interface_log"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
