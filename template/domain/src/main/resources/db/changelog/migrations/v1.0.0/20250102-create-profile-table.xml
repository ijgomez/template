<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250102-create-profile-table" author="template" labels="v1.0.0">

                <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="profile"/>
            </not>
        </preConditions>

<comment>Creación de la tabla de perfiles de seguridad</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="profile">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyTablespace="${tablespaceIndex}" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="profile" columnNames="name"
                             constraintName="profile_name_UK"/>

        <createSequence schemaName="${schemaName}" sequenceName="profile_seq" startValue="1" incrementBy="50"/>

        <rollback>
            <dropSequence schemaName="${schemaName}" sequenceName="profile_seq"/>
            <dropTable schemaName="${schemaName}" tableName="profile"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
