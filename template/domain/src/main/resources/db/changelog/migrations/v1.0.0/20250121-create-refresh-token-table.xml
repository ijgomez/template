<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250121-create-refresh-token-table" author="template" labels="v1.0.0">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="refresh_token"/>
            </not>
        </preConditions>

        <comment>Creación de la tabla de refresh tokens para persistencia de sesiones</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="refresh_token">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyTablespace="${tablespaceIndex}" nullable="false"/>
            </column>
            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="user_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="revoked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="refresh_token" columnNames="token"
                             constraintName="refresh_token_token_UK"/>

        <createSequence schemaName="${schemaName}" sequenceName="refresh_token_seq" startValue="1" incrementBy="1"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="refresh_token" baseColumnNames="user_fk"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="refresh_token_user_FK"/>

        <createIndex schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="refresh_token" indexName="refresh_token_token_IDX">
            <column name="token"/>
        </createIndex>

        <createIndex schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="refresh_token" indexName="refresh_token_user_fk_IDX">
            <column name="user_fk"/>
        </createIndex>

        <rollback>
            <dropSequence schemaName="${schemaName}" sequenceName="refresh_token_seq"/>
            <dropTable schemaName="${schemaName}" tableName="refresh_token"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
