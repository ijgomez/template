<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250114-create-cluster-job-table" author="template" labels="v1.0.0">

                <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="cluster_job"/>
            </not>
        </preConditions>

<comment>Creación de la tabla de trabajos del clúster (composite PK)</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="cluster_job">
            <column name="cluster_node_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cluster_task_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="cluster_job" columnNames="cluster_node_fk, cluster_task_fk"
                       constraintName="cluster_job_PK"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="cluster_job" baseColumnNames="cluster_node_fk"
                                 referencedTableName="cluster_node" referencedColumnNames="id"
                                 constraintName="cluster_job_cluster_node_FK"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="cluster_job" baseColumnNames="cluster_task_fk"
                                 referencedTableName="cluster_task" referencedColumnNames="id"
                                 constraintName="cluster_job_cluster_task_FK"/>

        <rollback>
            <dropTable schemaName="${schemaName}" tableName="cluster_job"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
