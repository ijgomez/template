<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250104-create-profile2action-table" author="template" labels="v1.0.0">

                <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${schemaName}" tableName="profile2action"/>
            </not>
        </preConditions>

<comment>Creación de la tabla intermedia perfil-acción</comment>

        <createTable schemaName="${schemaName}" tablespace="${tablespaceData}" tableName="profile2action">
            <column name="profile_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="action_fk" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint schemaName="${schemaName}" tablespace="${tablespaceIndex}" tableName="profile2action" columnNames="profile_fk, action_fk"
                             constraintName="profile2action_profile_fk_action_fk_UK"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="profile2action" baseColumnNames="profile_fk"
                                 referencedTableName="profile" referencedColumnNames="id"
                                 constraintName="profile2action_profile_FK"/>

        <addForeignKeyConstraint baseTableSchemaName="${schemaName}" referencedTableSchemaName="${schemaName}" baseTableName="profile2action" baseColumnNames="action_fk"
                                 referencedTableName="action" referencedColumnNames="id"
                                 constraintName="profile2action_action_FK"/>

        <rollback>
            <dropTable schemaName="${schemaName}" tableName="profile2action"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
