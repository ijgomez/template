<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Changelog de desarrollo local.

        Incluye el esquema y las semillas comunes (db.changelog-master.xml) y,
        ADEMÁS, las semillas de desarrollo (usuario administrador, informes,
        nodos, auditoría, parámetros, interfaces...).

        Estas semillas 'seed-local-*' NO se incluyen en db.changelog-master.xml
        para que los entornos desplegados (perfil 'dist') nunca creen el perfil
        Administrador ni el usuario 'admin' con credenciales conocidas (SEC-01).

        Solo lo referencia application-local.yml.
    -->

    <include file="db.changelog-master.xml" relativeToChangelogFile="true"/>

    <include file="data/v1.0.0/20250116-seed-local-admin.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250117-seed-local-reports.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250118-seed-local-cluster-node.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250119-seed-local-audit-log.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250120-seed-local-interface-log.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250122-seed-local-parameter.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250123-seed-local-interface.xml" relativeToChangelogFile="true"/>
    <include file="data/v1.0.0/20250124-seed-local-interface-log-h2.xml" relativeToChangelogFile="true"/>

</databaseChangeLog>
