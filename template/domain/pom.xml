<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.myorganization.template</groupId>
        <artifactId>template</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>template-domain</artifactId>
    <packaging>jar</packaging>

    <name>Template - Domain</name>
    <description>Domain model - JPA entities, DTOs and value objects (pure Java, no Spring)</description>

    <dependencies>
        <!-- Module dependencies -->
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-cluster</artifactId>
        </dependency>

        <!-- Jakarta Persistence API (JPA annotations only, no Spring) -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- Jakarta Validation API (for bean validation annotations) -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JaCoCo: exclusiones propias del modelo de datos de este módulo.
                Los patrones aplican sobre la ruta de la clase compilada (.class).
                Versión y ejecuciones (prepare-agent/report/merge) se heredan del
                pluginManagement del POM padre; aquí solo se añaden los <excludes>.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- DTOs (records sin lógica) -->
                        <exclude>**/dto/**</exclude>
                        <!-- Criterios de búsqueda (records/POJOs sin lógica) -->
                        <exclude>**/criteria/**</exclude>
                        <!-- Enumerados (constantes) -->
                        <exclude>**/enums/**</exclude>
                        <!-- Excepciones (subclases de RuntimeException, sólo constructores) -->
                        <exclude>**/exception/**</exclude>
                        <!-- Entities JPA que son sólo getters/setters. NO se excluye
                             el paquete entity completo para conservar la cobertura de
                             BaseEntity y de las claves compuestas *PK, que sí tienen
                             lógica (equals/hashCode, callbacks de ciclo de vida). -->
                        <exclude>**/entity/Action.class</exclude>
                        <exclude>**/entity/AuditLog.class</exclude>
                        <exclude>**/entity/ClusterBlock.class</exclude>
                        <exclude>**/entity/ClusterJob.class</exclude>
                        <exclude>**/entity/ClusterNode.class</exclude>
                        <exclude>**/entity/ClusterTask.class</exclude>
                        <exclude>**/entity/Interface.class</exclude>
                        <exclude>**/entity/InterfaceLog.class</exclude>
                        <exclude>**/entity/Parameter.class</exclude>
                        <exclude>**/entity/Profile.class</exclude>
                        <exclude>**/entity/Profile2Action.class</exclude>
                        <exclude>**/entity/RefreshToken.class</exclude>
                        <exclude>**/entity/Report.class</exclude>
                        <exclude>**/entity/User.class</exclude>
                        <exclude>**/entity/User2Report.class</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <version>${liquibase.version}</version>
                <configuration>
                    <propertyFile>src/main/resources/liquibase.properties</propertyFile>
                </configuration>
                <dependencies>
                    <!-- Dependencias SOLO del plugin, no del módulo -->
                    <dependency>
                        <groupId>org.liquibase</groupId>
                        <artifactId>liquibase-core</artifactId>
                        <version>${liquibase.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>

</project>
