# Configuración de Lombok para todos los módulos del proyecto.
config.stopBubbling = true

# Copia @Value y @Qualifier de los campos al constructor generado por
# @RequiredArgsConstructor; sin esto Spring no puede resolver los parámetros
# (p. ej. "No qualifying bean of type 'int'").
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
