<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.myorganization.template</groupId>
        <artifactId>template</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>template-webapp</artifactId>
    <packaging>war</packaging>

    <name>Template - Webapp</name>
    <description>REST API, Spring Boot configuration and security</description>

    <properties>
        <!--
            Cuando es true no se copia el 'dist/' de Angular al WAR (útil junto con
            -Dfrontend.skip=true, que además evita que el módulo dashboard compile el
            frontend). El build y los tests del frontend viven en el módulo dashboard.
        -->
        <frontend.skip>false</frontend.skip>
    </properties>

    <dependencies>
        <!-- Module dependencies -->
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-ws</artifactId>
			<version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!--
            Módulos declarados explícitamente para que el reporte JaCoCo agregado
            ('report-aggregate') incluya su cobertura. Ya llegan en compile de forma
            transitiva vía template-core, por lo que declararlos aquí (scope compile,
            por defecto) no altera el classpath real ni el contenido del WAR; sólo
            los hace visibles como parte del agregado de cobertura.
        -->
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-cluster</artifactId>
        </dependency>
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-domain</artifactId>
        </dependency>

        <!--
            Dependencia al módulo frontend: no aporta clases (packaging pom), sólo
            fuerza el orden del reactor para que 'template-dashboard' compile el
            'dist/' de Angular ANTES de que webapp lo copie al WAR.
        -->
        <dependency>
            <groupId>org.myorganization.template</groupId>
            <artifactId>template-dashboard</artifactId>
            <version>0.1.0-SNAPSHOT</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>

        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT (JJWT) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson Java Time Module (for JSR-310 date/time serialization) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (monitoring) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Liquibase (database migrations at startup) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- Servlet API (provided by container for WAR) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing: Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testing: Spring Boot WebMvc Test (AutoConfigureMockMvc, etc.) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testing: Spring Security Test -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testing: jqwik (property-based testing) -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testing: Testcontainers -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Resource filtering: resolve @...@ placeholders in application.yml -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application.yml</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <!--
                Copy Angular build output to WAR static resources.
                El frontend (Node, npm install, build y tests) lo gestiona el módulo
                'template-dashboard'; aquí sólo se copia el 'dist/' que ya generó.
            -->
            <!-- Copy Angular build output to WAR static resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${frontend.skip}</skip>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../dashboard/dist/dashboard/browser</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
					<mainClass>org.myorganization.template.webapp.TemplateApplication</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
            </plugin>

            <!--
                JaCoCo: reporte AGREGADO con la cobertura de todos los módulos.
                'report-aggregate' combina los datos de ejecución de los módulos que
                webapp declara como dependencia y que forman parte del reactor
                (commons, cluster, domain, core, ws). Se genera en la fase 'verify'
                (por eso debe ejecutarse el reactor completo, p. ej. 'mvn verify').
                Hereda los <excludes> definidos en el POM padre.
                Salida: webapp/target/site/jacoco-aggregate/index.html
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-aggregate</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
