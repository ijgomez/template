<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250107-create-parameter-table" author="template" labels="v1.0.0">

        <comment>Creación de la tabla de parámetros del sistema</comment>

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="parameter"/>
            </not>
        </preConditions>

        <createTable tableName="parameter">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="value" type="VARCHAR(500)"/>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_modified_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createSequence sequenceName="parameter_SEQ" startValue="1" incrementBy="50"/>

        <rollback>
            <dropSequence sequenceName="parameter_SEQ"/>
            <dropTable tableName="parameter"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
