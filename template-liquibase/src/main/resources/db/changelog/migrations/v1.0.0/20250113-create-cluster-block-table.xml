<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250113-create-cluster-block-table" author="template" labels="v1.0.0">

        <comment>Creación de la tabla de bloqueos del clúster</comment>

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="cluster_block"/>
            </not>
        </preConditions>

        <createTable tableName="cluster_block">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="start_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="avg_time" type="BIGINT"/>
            <column name="min_time" type="BIGINT"/>
            <column name="max_time" type="BIGINT"/>
            <column name="total" type="BIGINT"/>
        </createTable>

        <createSequence sequenceName="cluster_block_SEQ" startValue="1" incrementBy="50"/>

        <addForeignKeyConstraint baseTableName="cluster_block" baseColumnNames="name"
                                 referencedTableName="cluster_task" referencedColumnNames="name"
                                 constraintName="cluster_block_name_FK"
                                 onDelete="RESTRICT" onUpdate="CASCADE"/>

        <rollback>
            <dropSequence sequenceName="cluster_block_SEQ"/>
            <dropTable tableName="cluster_block"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
