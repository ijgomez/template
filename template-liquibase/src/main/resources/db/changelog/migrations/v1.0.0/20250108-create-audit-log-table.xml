<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20250108-create-audit-log-table" author="template" labels="v1.0.0">

        <comment>Creación de la tabla de auditoría del sistema (append-only, inmutable)</comment>

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="audit_log"/>
            </not>
        </preConditions>

        <createTable tableName="audit_log">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="timestamp" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="operation_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="section" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="VARCHAR(100)"/>
            <column name="entity_name" type="VARCHAR(255)"/>
            <column name="detail" type="TEXT"/>
        </createTable>

        <createSequence sequenceName="audit_log_SEQ" startValue="1" incrementBy="50"/>

        <createIndex tableName="audit_log" indexName="idx_audit_log_timestamp_username">
            <column name="timestamp"/>
            <column name="username"/>
        </createIndex>

        <createIndex tableName="audit_log" indexName="idx_audit_log_operation_type">
            <column name="operation_type"/>
        </createIndex>

        <createIndex tableName="audit_log" indexName="idx_audit_log_section">
            <column name="section"/>
        </createIndex>

        <rollback>
            <dropIndex tableName="audit_log" indexName="idx_audit_log_section"/>
            <dropIndex tableName="audit_log" indexName="idx_audit_log_operation_type"/>
            <dropIndex tableName="audit_log" indexName="idx_audit_log_timestamp_username"/>
            <dropSequence sequenceName="audit_log_SEQ"/>
            <dropTable tableName="audit_log"/>
        </rollback>

    </changeSet>

</databaseChangeLog>
